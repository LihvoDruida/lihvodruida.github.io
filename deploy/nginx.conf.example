# Append inside the HTTP context (after existing server blocks) in
# /srv/mistblossom/deploy/nginx/dashboard.conf.
# First issue the certificate as described in deploy/VPS.md.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name lihvodruida.pp.ua www.lihvodruida.pp.ua;
    ssl_certificate /etc/letsencrypt/live/lihvodruida.pp.ua/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lihvodruida.pp.ua/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    resolver 127.0.0.11 valid=10s ipv6=off;
    location / {
        set $public_site http://lihvodruida-public-site:3000;
        proxy_pass $public_site;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
