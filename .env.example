# Public Node.js/Next.js site. No Discord, PostgreSQL or OAuth secrets here.
SITE_URL=https://lihvodruida.pp.ua
DASHBOARD_URL=https://guild.lihvodruida.pp.ua
# Required private transport on mistblossom_edge for reads and application submission.
# Set the SAME 64-character random token in the dashboard root .env.
# Generation: openssl rand -hex 32
DASHBOARD_INTERNAL_URL=http://dashboard:3000
PUBLIC_SITE_BRIDGE_TOKEN=
# Suppressed unchanged refresh logs can be enabled for diagnosis.
SITE_DEBUG_LOGS=false

# Existing Nginx network of /srv/mistblossom.
SITE_EDGE_NETWORK=mistblossom_edge
# Limit build load on the VPS.
NEXT_BUILD_CPUS=2
NODE_BUILD_MEMORY_MB=1536

# Server-only API key; never expose it as NEXT_PUBLIC_* and rotate the previous hard-coded key.
CURSEFORGE_API_KEY=
CURSEFORGE_AUTHOR_ID=104580421
