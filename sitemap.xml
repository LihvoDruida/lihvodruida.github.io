---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  {% comment %} --- 1. POSTS (НОВИНИ) --- {% endcomment %}
  {% for post in site.posts %}
    {% unless post.published == false or post.sitemap == false %}
      <url>
        <loc>{{ site.url }}{{ post.url | remove: "index.html" }}</loc>
        <lastmod>
          {% if post.last_modified_at %}
            {{ post.last_modified_at | date_to_xmlschema }}
          {% else %}
            {{ post.date | date_to_xmlschema }}
          {% endif %}
        </lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
      </url>
    {% endunless %}
  {% endfor %}

  {% comment %} --- 2. PAGES (СТАТИЧНІ СТОРІНКИ) --- {% endcomment %}
  {% for page in site.pages %}
    {% comment %} Фільтрація: тільки HTML, не 404, не ассети, не відключені {% endcomment %}
    {% if page.url contains '.html' or page.url contains '/' %}
      {% unless page.url contains '404' or page.url contains 'assets' or page.url contains '.css' or page.name == 'sitemap.xml' or page.sitemap == false %}
        <url>
          <loc>{{ site.url }}{{ page.url | remove: "index.html" }}</loc>
          <lastmod>
            {% if page.last_modified_at %}
              {{ page.last_modified_at | date_to_xmlschema }}
            {% elsif page.date %}
              {{ page.date | date_to_xmlschema }}
            {% else %}
              {{ site.time | date_to_xmlschema }}
            {% endif %}
          </lastmod>
          
          {% if page.url == "/" %}
            <changefreq>daily</changefreq>
            <priority>1.0</priority>
          {% else %}
            <changefreq>weekly</changefreq>
            <priority>0.9</priority>
          {% endif %}
        </url>
      {% endunless %}
    {% endif %}
  {% endfor %}

</urlset>
