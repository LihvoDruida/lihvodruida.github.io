GITHUB_OWNER=LihvoDruida
GITHUB_REPO=lihvodruida.github.io
GITHUB_TOKEN=github_pat_or_classic_token_with_issues_and_contents_write
GUILD_APPLICATIONS_LABEL=guild-application
SESSION_SECRET=replace-with-random-32-plus-character-secret

NEXT_PUBLIC_DASHBOARD_URL=https://admin.lihvodruida.pp.ua
DASHBOARD_URL=https://admin.lihvodruida.pp.ua

# Discord OAuth is the main login method.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# Discord role access. Only ENV controls access; dashboard cannot edit these values.
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_MODERATOR_ROLE_IDS=

# Emergency fallback only. Admin role. Keep secret.
ADMIN_DASHBOARD_TOKEN=

RAIDERIO_ENABLED=true
RAIDERIO_CONCURRENCY=6
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Optional: duplicate /admin/logs audit records into a dedicated Discord channel as embeds.
# Can also be configured from /admin/logs when Firebase is available.
ADMIN_LOGS_DISCORD_ENABLED=false
ADMIN_LOGS_DISCORD_CHANNEL_ID=
ADMIN_LOGS_DISCORD_MIN_STATUS=warning
ADMIN_LOGS_DISCORD_INCLUDE_SYSTEM=true


DISCORD_GUILD_NAME=Mistblossom Vanguard
