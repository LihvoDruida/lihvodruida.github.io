---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  {% for page in site.pages %}
    {% unless page.sitemap == false or page.name == 'sitemap.xml' or page.url contains 'assets' or page.url contains '.css' or page.url contains '404' or page.url contains 'callback' %}
      <url>
        <loc>{{ site.url }}{{ page.url | remove: 'index.html' }}</loc>
        <lastmod>
          {% if page.last_modified_at %}
            {{ page.last_modified_at | date_to_xmlschema }}
          {% elsif page.date %}
            {{ page.date | date_to_xmlschema }}
          {% else %}
            {{ site.time | date_to_xmlschema }}
          {% endif %}
        </lastmod>
        {% if page.url == '/' %}
          <changefreq>daily</changefreq>
          <priority>1.0</priority>
        {% else %}
          <changefreq>weekly</changefreq>
          <priority>0.8</priority>
        {% endif %}
      </url>
    {% endunless %}
  {% endfor %}

  {% for doc in site.news %}
    {% unless doc.published == false or doc.sitemap == false %}
      <url>
        <loc>{{ site.url }}{{ doc.url | remove: 'index.html' }}</loc>
        <lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
      </url>
    {% endunless %}
  {% endfor %}

  {% for doc in site.guides %}
    {% unless doc.published == false or doc.sitemap == false %}
      <url>
        <loc>{{ site.url }}{{ doc.url | remove: 'index.html' }}</loc>
        <lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
      </url>
    {% endunless %}
  {% endfor %}

</urlset>
